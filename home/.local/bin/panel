#!/bin/sh
# Opens one of the bar's panels, or closes it if it's already open.
#   panel control-center | clips | clipboard | screenshots | wifi | bluetooth | sound |
#         power | tools | notes | overview
#   panel --warm     starts them in the background, hidden (Hyprland runs this at login)
#
# The panels live in programs that keep running once started, so a click only has to tell one
# to show a panel instead of starting Python again. That's what makes them open at once.
# The Control Center and the overview have a program each; the rest share one (gear-tools.py).
dir="$HOME/.config/waybar"

# resident ID FILE [ARGUMENT...]: asks a running program to open (or close) itself, or starts it
resident() {
    id=$1
    shift
    path=/$(echo "$id" | tr . /)
    if [ -n "$standby" ]; then
        # Already running? Then there's nothing to warm up
        busctl --user status "$id" >/dev/null 2>&1 || setsid -f python3 "$@" --standby >/dev/null 2>&1
    else
        busctl --user call "$id" "$path" org.freedesktop.Application Activate 'a{sv}' 0 >/dev/null 2>&1 \
            || setsid -f python3 "$@" >/dev/null 2>&1
    fi
}

app() {
    case "$1" in
        control-center) resident local.waybar.ControlCenter "$dir/control-center.py" ;;
        overview)       resident local.waybar.Overview "$dir/overview.py" ;;
        clips|clipboard|screenshots|wifi|bluetooth|sound|power|tools|notes)
            busctl --user call local.waybar.Panels /local/waybar/Panels org.freedesktop.Application \
                ActivateAction 'sava{sv}' "$1" 0 0 >/dev/null 2>&1 \
                || setsid -f python3 "$dir/gear-tools.py" --open "$1" >/dev/null 2>&1 ;;
        *) echo "panel: no panel called $1" >&2; exit 1 ;;
    esac
}

if [ "$1" = --warm ]; then
    standby=1
    app control-center
    app overview
    busctl --user status local.waybar.Panels >/dev/null 2>&1 \
        || setsid -f python3 "$dir/gear-tools.py" --standby >/dev/null 2>&1
else
    app "$1"
fi
