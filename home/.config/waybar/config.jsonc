// macOS-style menu bar: full-width, flat, translucent
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin": 0,
    "spacing": 0,

    "modules-left": [
        "custom/apple",
        "hyprland/window",
        "group/learning"
    ],
    "modules-center": ["custom/notch"],
    "modules-right": [
        "tray",
        "pulseaudio",
        "bluetooth",
        "network",
        "clock"
    ],

    "custom/apple": {
        "format": " ",
        "tooltip": false
    },

    // App name in bold, like macOS (shows the focused app's class)
    "hyprland/window": {
        "format": "{class}",
        "max-length": 24,
        "separate-outputs": true,
        // Clean app names. Rules run in alphabetical order, so the "z{0}" fallbacks stay last
        "rewrite": {
            "^$": "Finder",
            "^amdgpu_top$": "AMDGPU Top",
            "^assistant$": "Qt Assistant",
            "^blender$": "Blender",
            "^blueman-manager$": "Bluetooth",
            "^btop$": "btop",
            "^com\\.anthropic\\.claude$": "Claude",
            "^designer$": "Qt Designer",
            "^discord$": "Discord",
            "^firefox$": "Firefox",
            "^htop$": "htop",
            "^io\\.github\\.klobraticc\\.voidstrap$": "Voidstrap",
            "^kdesystemsettings$": "System Settings",
            "^kitty$": "Kitty",
            "^liner$": "Liner",
            "^linguist$": "Qt Linguist",
            "^lstopo$": "lstopo",
            "^mpv$": "mpv",
            "^nm-connection-editor$": "Network Settings",
            "^org\\.kde\\.discover$": "Discover",
            "^org\\.kde\\.dolphin$": "Dolphin",
            "^org\\.kde\\.drkonqi\\.coredump\\.gui$": "Crash Viewer",
            "^org\\.kde\\.kinfocenter$": "Info Center",
            "^org\\.kde\\.kmenuedit$": "Menu Editor",
            "^org\\.kde\\.konsole$": "Konsole",
            "^org\\.kde\\.plasma-systemmonitor$": "System Monitor",
            "^org\\.kde\\.plasma-welcome$": "Welcome Center",
            "^org\\.kde\\.plasma\\.emojier$": "Emoji Selector",
            "^org\\.kde\\.spectacle$": "Spectacle",
            "^org\\.mozilla\\.firefox$": "Firefox",
            "^org\\.pulseaudio\\.pavucontrol$": "Volume Control",
            "^org\\.vinegarhq\\.sober$": "Sober",
            "^org\\.vinegarhq\\.vinegar$": "Vinegar",
            "^pavucontrol$": "Volume Control",
            "^qdbusviewer$": "Qt D-Bus Viewer",
            "^qv4l2$": "Qt V4L2",
            "^qvidcap$": "Qt Video Capture",
            "^robloxplayerbeta\\.exe$": "Roblox",
            "^robloxstudiobeta\\.exe$": "Roblox Studio",
            "^steam$": "Steam",
            "^steam_app_322170$": "Geometry Dash",
            "^steam_app_381210$": "Dead by Daylight",
            "^steam_app_\\d+$": "Steam Game",
            "^systemsettings$": "System Settings",
            "^vim$": "Vim",
            "^voidstrap$": "Voidstrap",
            "^z{0}(.+)\\.exe$": "$1",
            "^z{0}(?:[a-z0-9_-]+\\.)+([^.]+)$": "$1"
        }
    },

    // Gear: click it to slide out the clips and gear-tools buttons (icons only), click again to hide them
    "group/learning": {
        "orientation": "horizontal",
        "drawer": {
            "click-to-reveal": true,
            "transition-duration": 300,
            "children-class": "learning-drawer",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/gear",
            "custom/clips",
            "custom/clipboard",
            "custom/screenshots",
            "custom/power"
        ]
    },

    // Gear tools (see gear-tools.py): clipboard history, screenshots, power menu
    "custom/clipboard": {
        "format": " ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/panel clipboard"
    },
    "custom/screenshots": {
        "format": " ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/panel screenshots"
    },
    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/panel power"
    },

    // Clips (see clips.py): the film opens the clips panel, with the recording on/off switch
    // (Super+Insert) at the top and every clip below, newest first. Insert saves the last 30 seconds
    "custom/clips": {
        "format": " ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/panel clips"
    },
    "custom/gear": {
        "format": " ",
        "tooltip": false
    },

    // Starts the black notch, which draws itself in its own window (see notch.py)
    "custom/notch": {
        "exec": "python3 $HOME/.config/waybar/notch.py",
        "restart-interval": 5,
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "bluetooth": {
        // The icons on this side of the bar are drawn by style.css (see the icons folder)
        "format": " ",
        "format-connected": " ",
        "format-off": " ",
        "format-disabled": " ",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "$HOME/.local/bin/panel bluetooth",
        "on-click-right": "blueman-manager"
    },

    // Volume: click for the sound panel (master volume, a slider per app, and which speakers
    // and microphone to use); right-click to mute
    "pulseaudio": {
        "format": " ",
        "format-muted": " ",
        "tooltip-format": "Volume: {volume}%",
        // Scrolling over the icon does nothing, so the volume can't change by accident
        "scroll-step": 0,
        "on-scroll-up": "true",
        "on-scroll-down": "true",
        "on-click": "$HOME/.local/bin/panel sound",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": " ",
        "format-disconnected": " ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "on-click": "$HOME/.local/bin/panel wifi",
        "on-click-right": "nm-connection-editor"
    },

    // "Sat 31 Oct  2:32 PM". Click for the Control Center (see control-center.py)
    "clock": {
        "format": "{:%a %d %b  %I:%M %p}",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/panel control-center"
    }
}
