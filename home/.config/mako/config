# macOS-style glass notifications
font=Inter 11
anchor=top-right
layer=overlay

# Sit just below the 28px top bar, with a gap from the screen edge
margin=34,14,0,0
outer-margin=0

width=360
height=140
padding=14,16
border-size=1
border-radius=18
border-color=#ffffff2e

# macOS-style frosted glass: rich dark tint over vibrant blur, fine hairline edge
background-color=#2a2a2eb8
text-color=#ffffffff
progress-color=over #0a84ffcc

icons=1
max-icon-size=44
icon-border-radius=10

markup=1
format=<b>%s</b>\n%b
text-alignment=left

default-timeout=5000
ignore-timeout=0
max-visible=4
sort=-time

[urgency=low]
border-color=#ffffff1f

[urgency=critical]
border-color=#ff453aaa
default-timeout=0

# Volume display from mac-osd: compact, white bar, stays out of notification history
[app-name=osd]
width=240
progress-color=over #ffffffcc
history=0

# Do Not Disturb (toggled from the Control Center): hide notifications,
# but keep the volume display
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=osd]
invisible=0

# "No Alerts" from the game menu, on only while that game is focused
[mode=game]
invisible=1

[mode=game app-name=osd]
invisible=0

# "Clip saved" (clips.py) always shows, even with Do Not Disturb or No Alerts on
[mode=do-not-disturb app-name=clips]
invisible=0

[mode=game app-name=clips]
invisible=0
